<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Contenedor de los botones -->
    <LinearLayout
        android:id="@+id/button_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="16dp"
        android:elevation="8dp"
        android:clipToOutline="true"
        android:outlineProvider="background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.75">

        <!-- Botón superior con color distintivo -->
        <Button
            android:id="@+id/button1"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="Explicarme lo que veo"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_light"
            android:layout_marginBottom="8dp"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
			android:layout_gravity="center"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:elevation="5dp" />

        <!-- Botón combinado con imagen superpuesta -->
        <FrameLayout
            android:id="@+id/combined_button"
            android:layout_width="wrap_content"
            android:layout_height="128dp"
            android:layout_marginTop="8dp"
            android:elevation="5dp"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <!-- Fondo del botón -->
            <Button
                android:id="@+id/button_combined"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:text="Hazme una pregunta o realiza otra acción"
                android:textColor="@android:color/white"
				android:backgroundTint="@android:color/transparent"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp" />

            <!-- Imagen superpuesta -->
            <ImageView
                android:id="@+id/overlay_image"
                android:layout_width="128dp"
                android:layout_height="256dp"
                android:layout_gravity="center"
                android:contentDescription="Icono del botón"
                android:elevation="6dp"/>
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
